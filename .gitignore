# Unreal Engine 4 & 5 .gitignore
# Recommended by Epic Games and GitHub

# Build Folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.vscode/

# Compiled source files
*.pdb
*.exe
*.dll
*.lib
*.app
*.dylib
*.ipa
*.so
*.a
*.exp
*.patch_*

# Logs and crash dumps
*.log
*.dmp

# Ignore Mac files
.DS_Store

# Ignore Windows thumbnail cache
Thumbs.db

# Ignore backup files
*.bak
*.tmp

# Ignore generated project files
*.xcodeproj
*.xcworkspace
*.xcconfig
*.xcuserdata
*.xcuserstate
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Ignore plugin intermediates
Plugins/*/Intermediate/
Plugins/*/Binaries/

# Ignore config files that are user-specific
Config/DefaultEditorPerProjectUserSettings.ini
Config/DefaultEditorUserSettings.ini

# Ignore local build data
Build/

# Ignore Unreal AutomationTool logs
AutomationTool/Logs/

# Ignore crash reports
CrashReportClient/Saved/

# Ignore local launcher data
Launcher/Engine/Binaries/Win64/UnrealVersionSelector.exe

# Ignore custom
*.swp
*.swo

# End of file

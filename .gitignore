# Unreal Engine standard .gitignore
# Exclude build and cache folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# Exclude user-specific and temporary files
*.suo
*.user
*.userosscache
*.sln.docstates
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.vscode/

# Exclude packaged builds
Packaged/
Standalone/

# Exclude log files
*.log

# Exclude crash reports
*.dmp

# Exclude local config (optional)
Config/DefaultEditorPerProjectUserSettings.ini
Config/DefaultEditorUserSettings.ini

# Exclude Mac and Linux files
.DS_Store
*.swp

# Exclude Windows thumbnail cache
Thumbs.db

# Exclude backup files
*.bak
*.tmp

# Exclude Python cache
__pycache__/
*.pyc

# Ignore plugin intermediates
Plugins/*/Intermediate/
Plugins/*/Binaries/

# Ignore local build data
Build/

# Ignore Unreal AutomationTool logs
AutomationTool/Logs/

# Ignore crash reports
CrashReportClient/Saved/

# Ignore local launcher data
Launcher/Engine/Binaries/Win64/UnrealVersionSelector.exe

# End of file

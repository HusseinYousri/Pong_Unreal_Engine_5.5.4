# Unreal Engine 5 project .gitignore

# Build and intermediate folders
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# User and system files
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb
*.vscode/
*.opensdf
*.sdf
*.log
*.tlog
*.pdb
*.ipch
*.aps
*.ncb
*.cache
*.obj
*.exe
*.dll
*.exp
*.lib
*.tmp
*.csproj
*.vcxproj*
*.xcodeproj
*.xcworkspace
*.DS_Store
Thumbs.db

# Ignore local engine builds (if not shared)
Engine/Binaries/
Engine/Build/
Engine/DerivedDataCache/
Engine/Intermediate/
Engine/Saved/

# Ignore crash reports and autosaves
Saved/Autosaves/
Saved/Crashes/
Saved/Logs/
Saved/Config/
Saved/Collections/
Saved/Screenshots/
Saved/ShaderDebugInfo/
Saved/SourceControl/
Saved/UnrealBuildTool/

# Ignore Visual Studio Code workspace settings (optional)
*.code-workspace

# Ignore backup files
*.bak